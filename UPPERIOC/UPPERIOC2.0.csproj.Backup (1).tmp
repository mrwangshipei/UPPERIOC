<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>UPPERIOC2</RootNamespace>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <LangVersion>preview</LangVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <TargetFrameworks>net462</TargetFrameworks>
  </PropertyGroup>
	<Import Project="$(MSBuildThisFileDirectory)targets\UPPERIOC.targets" />
	<Import Project="$(MSBuildThisFileDirectory)targets\UPPERIOC.props" />

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="System.Management" Version="4.6.0" />
  </ItemGroup>

  <Target Name="ConfigureParentProject" AfterTargets="GetTargetPath">
    <!-- Add the analyzer settings to the parent project -->
    <ItemGroup>
      <ProjectReferenceOutput Include="$(TargetPath)">
        <OutputItemType>Analyzer</OutputItemType>
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      </ProjectReferenceOutput>
    </ItemGroup>
  </Target>
<PropertyGroup>
  <Version>2.0.1.3</Version>
  <PackageId>UPPERIOC</PackageId>
  <Authors>Net Wsp</Authors>
  <Description>一个自带插件的IOC容器</Description>
</PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IOCCodeGenerator\IOCCodeGenerator.csproj" />

  </ItemGroup>
<ItemGroup>
  <None Include="..\IOCCodeGenerator\bin\$(Configuration)\netstandard2.0\IOCCodeGenerator.dll">
    <Pack>true</Pack>
    <PackagePath>analyzers\dotnet\roslyn3.8\cs</PackagePath>
  </None>
  <None Include="bin\$(Configuration)\net462\UPPERIOC2.0.dll">
    <Pack>true</Pack>
    <PackagePath>lib\net462</PackagePath>
  </None>
  <!-- We need this one to catch older clients -->

    
</ItemGroup>


		
	<PropertyGroup>
  <IncludeBuildOutput>false</IncludeBuildOutput>
  <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
  <SignAssembly>True</SignAssembly>
  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  <EnableNETAnalyzers>True</EnableNETAnalyzers>
  <AnalysisLevel>latest</AnalysisLevel>
  <Nullable>enable</Nullable>
  <PackageOutputPath>C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\</PackageOutputPath>
  <Title>UPPERIOC</Title>
  <NeutralLanguage>zh-Hans</NeutralLanguage>
  <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  <IncludeSymbols>False</IncludeSymbols>
  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  <PackageReadmeFile>README.md</PackageReadmeFile>
  <PackAsTool>False</PackAsTool>
  <PackageProjectUrl>https://gitee.com/laowangm_m/upper-com-auto-test</PackageProjectUrl>
  <PackageIcon>9200301643_fef33a95-3a3c-41a9-8d72-f3aa5d0c74dd.png</PackageIcon>
  <RepositoryUrl>https://gitee.com/laowangm_m/upper-com-auto-test</RepositoryUrl>
  <RepositoryType>gitee</RepositoryType>
  <PackageTags>ioc</PackageTags>
  <PackageReleaseNotes>初始版本</PackageReleaseNotes>
  <ImplicitUsings>enable</ImplicitUsings>
  <NuGetAudit>False</NuGetAudit>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net461|AnyCPU'">
  <DebugType>embedded</DebugType>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net461|AnyCPU'">
  <DebugType>embedded</DebugType>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net462|AnyCPU'">
  <DebugType>embedded</DebugType>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net462|AnyCPU'">
  <DebugType>embedded</DebugType>
</PropertyGroup>
<ItemGroup>
  <None Include="..\README.md">
    <Pack>True</Pack>
    <PackagePath>\</PackagePath>
  </None>
  <None Include="D:\Users\Wsp00\Pictures\9200301643_fef33a95-3a3c-41a9-8d72-f3aa5d0c74dd.png">
    <Pack>True</Pack>
    <PackagePath>\</PackagePath>
  </None>
</ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.5.2\System.Windows.Forms.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
