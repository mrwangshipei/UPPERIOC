<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
     <IsRoslynAnalyzer>true</IsRoslynAnalyzer> 
   <IsRoslynComponent>true</IsRoslynComponent>
<RootNamespace>UPPERIOC.Generators</RootNamespace>
   <SignAssembly>true</SignAssembly>
    <Nullable>enable</Nullable>
 <IsPackable>true</IsPackable>
   <SignAssembly>true</SignAssembly>
    <IsRoslynComponent>true</IsRoslynComponent>

    <DefineConstants>$(DefineConstants);ROSLYN_4</DefineConstants>
	
 
	
	  <EnableNETAnalyzers>True</EnableNETAnalyzers>
	  <AnalysisLevel>latest</AnalysisLevel>
	  <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>

	  <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <NeutralLanguage>zh-Hans</NeutralLanguage>
<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
<Description>UPPERIOC的生成器组件</Description>

	  <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>
<PropertyGroup>
  <EnableNETAnalyzers>true</EnableNETAnalyzers>
  <EnableAnalyzersSupport>true</EnableAnalyzersSupport>
  <PackageId>IOCG</PackageId>
  <Version>1.0.0.1</Version>
  <Title>IOCG</Title>
  <Copyright>www</Copyright>
  <IncludeSymbols>True</IncludeSymbols>
  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  <PackageIcon>UPPERIOC.png</PackageIcon>
  <PackageReadmeFile>README.md</PackageReadmeFile>
  <RepositoryType>git</RepositoryType>
  <Authors>Wwwwww</Authors>
  <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  <NeutralLanguage>zh</NeutralLanguage>
  <PackageProjectUrl>https://github.com/mrwangshipei/UPPERIOC</PackageProjectUrl>
  <RepositoryUrl>https://github.com/mrwangshipei/UPPERIOC</RepositoryUrl>
  <PackageTags>iocg</PackageTags>
  <PackageReleaseNotes>发布版本</PackageReleaseNotes>
  <AssemblyVersion>1.0.0.1</AssemblyVersion>
  <AssemblyName>IOCCodeGenerator</AssemblyName>
  <TargetFrameworks>netstandard2.0</TargetFrameworks>
  <PackageOutputPath>C:\Program Files (x86)\Microsoft SDKs\NuGetPackages</PackageOutputPath>

</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>


  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\UPPERIOC\UPPERIOC.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\UPPER.Shared\UPPER.Shared.projitems" Label="Shared" />

</Project>
