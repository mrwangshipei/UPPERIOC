<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
     <IsRoslynAnalyzer>true</IsRoslynAnalyzer> 
   <IsRoslynComponent>true</IsRoslynComponent>
<RootNamespace>UPPERIOC.Generators</RootNamespace>
   <SignAssembly>true</SignAssembly>
    <Nullable>enable</Nullable>
 <IsPackable>false</IsPackable>
   <SignAssembly>true</SignAssembly>
    <IsRoslynComponent>true</IsRoslynComponent>

    <DefineConstants>$(DefineConstants);ROSLYN_4</DefineConstants>

    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
<NeutralLanguage>zh-Hans</NeutralLanguage>
<Description>UPPERIOC的生成器组件</Description>
<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>
<PropertyGroup>
  <EnableNETAnalyzers>true</EnableNETAnalyzers>
  <EnableAnalyzersSupport>true</EnableAnalyzersSupport>
  <PackageId>IOCG</PackageId>
  <PackageOutputPath>C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\</PackageOutputPath>
</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0"   PrivateAssets="all"  />
  </ItemGroup>

  <Import Project="..\UPPER.Shared\UPPER.Shared.projitems" Label="Shared" />

</Project>
