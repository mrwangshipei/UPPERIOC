<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>$(BaseIntermediateOutputPath)\Analyzer</OutputPath>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
     <IsRoslynAnalyzer>true</IsRoslynAnalyzer> <!-- 标记为 Roslyn 分析器 -->
   <IsRoslynComponent>true</IsRoslynComponent>
<RootNamespace>UPPER.Generators</RootNamespace>
   <SignAssembly>true</SignAssembly>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <Import Project="..\UPPER.Shared\UPPER.Shared.projitems" Label="Shared" />

</Project>
